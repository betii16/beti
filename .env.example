# BETI v2 : variables d'environnement (copier vers .env.local et remplir)

# ── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé service (SERVEUR UNIQUEMENT : elle contourne toutes les règles d'accès).
# Ne jamais la préfixer par NEXT_PUBLIC_, ne jamais la coller dans un chat.
# Sert à une seule chose : la suppression de compte (src/app/api/account/delete).
SUPABASE_SERVICE_ROLE_KEY=

# URL publique du site, sans barre oblique finale.
NEXT_PUBLIC_SITE_URL=https://beti-ten.vercel.app

# Connexion par code SMS / WhatsApp : mettre 1 une fois le fournisseur configuré
# dans Supabase (Authentication > Providers > Phone). Sinon, connexion par e-mail.
NEXT_PUBLIC_PHONE_AUTH=0
