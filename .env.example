# BETI — variables d'environnement (copier vers .env.local et remplir)

# ── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé service-role (SERVEUR UNIQUEMENT, contourne le RLS — ne jamais préfixer
# NEXT_PUBLIC_). Dashboard Supabase > Project Settings > API > service_role.
SUPABASE_SERVICE_ROLE_KEY=

# URL publique du site, sans slash final. Sert à construire les URLs de retour
# que SATIM appelle après paiement (doit être joignable publiquement).
NEXT_PUBLIC_SITE_URL=https://beti-ten.vercel.app

# Paiement carte activé ? Laisser vide (ou 'false') pour un lancement CASH-ONLY :
# l'option carte est masquée et le cash devient le mode par défaut. Mettre 'true'
# UNIQUEMENT quand le compte marchand SATIM ci-dessous est en place et testé.
NEXT_PUBLIC_CARD_ENABLED=

# ── SATIM (e-paiement CIB / Edahabia) ───────────────────────────────────────
# Tout est fourni par ta banque après l'onboarding marchand SATIM.
#   SATIM_BASE_URL : https://test.satim.dz (test) ou https://cib.satim.dz (prod)
#   SATIM_USERNAME / SATIM_PASSWORD : identifiants marchands de la passerelle
#   SATIM_TERMINAL : force_terminal_id assigné par la banque
SATIM_BASE_URL=https://test.satim.dz
SATIM_USERNAME=
SATIM_PASSWORD=
SATIM_TERMINAL=

# ── Commission / lancement ──────────────────────────────────────────────────
# Date de lancement (ISO). 3 mois gratuits à partir de cette date : aucune
# commission carte prélevée avant. Si vide, fallback codé dans payment-config.ts.
NEXT_PUBLIC_LAUNCH_DATE=

# ── Séquestre (escrow) ──────────────────────────────────────────────────────
# Jeton protégeant le cron de libération auto du séquestre. Vercel l'envoie en
# « Authorization: Bearer <CRON_SECRET> ». Génère une chaîne aléatoire longue.
CRON_SECRET=
# Délai (jours) après encaissement carte avant libération auto si le client n'a
# pas confirmé la prestation. Défaut : 3.
ESCROW_RELEASE_DAYS=3
