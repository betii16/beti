# BETI — variables d'environnement (copier vers .env.local et remplir)

# ── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé service-role (SERVEUR UNIQUEMENT, contourne le RLS — ne jamais préfixer
# NEXT_PUBLIC_). Dashboard Supabase > Project Settings > API > service_role.
SUPABASE_SERVICE_ROLE_KEY=

# URL publique du site, sans slash final.
NEXT_PUBLIC_SITE_URL=https://beti-ten.vercel.app

# ── Lancement / abonnements ─────────────────────────────────────────────────
# Date de lancement (ISO). Les artisans sont gratuits jusqu'à LANCEMENT + 2 mois
# (période d'abonnement offerte, cf. lib/plans.ts). Si vide, fallback codé.
NEXT_PUBLIC_LAUNCH_DATE=
